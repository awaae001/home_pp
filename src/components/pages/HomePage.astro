---
import Layout from "../../layouts/Layout.astro";
import SolarSystem from "../SolarSystem.astro";
import AboutSections from "../AboutSections.astro";
import Link from "../ui/Link.astro";
import { Icon } from "astro-icon/components";
import { localizePath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
	lang={lang}
	title={t("site.title")}
	description={t("site.description")}
	canonicalPath={localizePath("/", lang)}
>
	<SolarSystem lang={lang} />
	<div id="main-mask" class="fixed inset-0 z-10 transition-opacity duration-500"></div>
	<div id="main-content" class="snap-container fixed inset-0 z-20 overflow-y-auto snap-y snap-mandatory scroll-smooth transition-opacity duration-500">
		<!-- 阅读进度 -->
		<div id="scroll-progress" class="fixed left-6 md:left-10 top-1/2 -translate-y-1/2 z-20 flex flex-col items-center gap-4 pointer-events-none opacity-0 transition-opacity duration-500">
			<span class="text-xs tracking-widest text-white/50" style="writing-mode: vertical-rl;">{t("about.progress")}</span>
			<div class="w-0.5 h-32 md:h-48 bg-white/10 rounded-full relative overflow-hidden">
				<div id="scroll-indicator" class="absolute top-0 left-0 w-full bg-white/80 rounded-full" style="height: 0%; transition: height 0.15s ease-out;"></div>
			</div>
			<span id="scroll-percentage" class="text-xs font-mono text-white/50 mt-1 w-8 text-center">0%</span>
		</div>

		<main class="relative flex flex-col items-center justify-center h-dvh px-4 text-right font-sans snap-center">
			<section>
				<h1 class="mb-12 md:mb-16 text-2xl md:text-5xl font-normal text-white tracking-tight animate-fade-in">
					{t("home.greeting")} <span class="font-hand" style="position: relative; top: -2px;">awaae001</span>
				</h1>
				<p class="mb-3 text-base md:text-lg text-gray-300 animate-fade-in opacity-0" style="animation-delay: 0.15s; animation-fill-mode: forwards;">
					{t("home.tagline")}
				</p>

				<div class="flex flex-wrap items-center justify-end gap-4 animate-fade-in-up">
					<Link
						text={t("nav.blog")}
						href="https://blog.awaae001.top"
						icon="mdi:pen"
						variant="capsule"
						external={true}
					/>
					<Link
						id="btn-website"
						text={t("nav.starMap")}
						icon="mdi:web"
						variant="article"
					/>
					<a
						href={localizePath("/projects", lang)}
						class="grid h-8 w-8 place-items-center text-gray-300 transition hover:text-white"
						data-pill-label={t("nav.projects")}
						aria-label={t("nav.projects")}
					>
						<Icon name="mdi:rocket-launch-outline" class="h-5 w-5" />
					</a>
					<a
						href="/tools"
						class="grid h-8 w-8 place-items-center text-gray-300 transition hover:text-white"
						data-pill-label={t("nav.tools")}
						aria-label={t("nav.tools")}
					>
						<Icon name="mdi:toolbox-outline" class="h-5 w-5" />
					</a>
				</div>
			</section>

			<a href="#about" class="scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2 text-white/40 hover:text-white transition-colors">
				<Icon name="mdi:chevron-double-down" class="w-6 h-6" />
			</a>
		</main>

		<AboutSections lang={lang} />
	</div>

	<div class="fixed top-6 right-6 z-20 flex gap-4">
		<button
			id="btn-toggle-flight"
			title={t("home.flight.enableTitle")}
			data-enabled="false"
			data-label-enable={t("home.flight.enable")}
			data-label-disable={t("home.flight.disable")}
			data-title-enable={t("home.flight.enableTitle")}
			data-title-disable={t("home.flight.disableTitle")}
			class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg backdrop-blur-sm border border-white/20 transition-all duration-500 opacity-0 pointer-events-none hover:scale-105 cursor-pointer flex items-center gap-2"
		>
			<Icon name="mdi:airplane" class="w-4 h-4" />
			<span id="flight-mode-label">{t("home.flight.enable")}</span>
		</button>
		<button
			id="btn-reset-view"
			class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg backdrop-blur-sm border border-white/20 transition-all duration-500 opacity-0 pointer-events-none hover:scale-105 cursor-pointer flex items-center gap-2"
		>
			<Icon name="mdi:refresh" class="w-4 h-4" />
			{t("home.resetView")}
		</button>
		<button
			id="btn-back"
			title={t("common.back")}
			class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg backdrop-blur-sm border border-white/20 transition-all duration-500 opacity-0 pointer-events-none hover:scale-105 cursor-pointer flex items-center justify-center"
		>
			<Icon name="mdi:arrow-left" class="w-4 h-4" />
		</button>
	</div>
</Layout>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.animate-fade-in {
		animation: fadeIn var(--motion-duration-slow) var(--motion-ease) forwards;
	}

	.animate-fade-in-up {
		animation: fadeInUp var(--motion-duration-slow) var(--motion-ease) 240ms forwards;
		opacity: 0;
	}

	@keyframes hintBounce {
		0%, 100% { transform: translate(-50%, 0); }
		50% { transform: translate(-50%, 6px); }
	}

	.scroll-hint {
		animation: hintBounce 2s ease-in-out infinite;
	}

	.snap-container {
		scrollbar-width: none;
	}

	.snap-container::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	import { setupPillTooltips } from "../../scripts/pill-tooltip";

	document.addEventListener('astro:page-load', () => {
		const cleanupPillTooltips = setupPillTooltips();
		document.addEventListener('astro:before-swap', () => cleanupPillTooltips(), { once: true });

		const btnWebsite = document.getElementById('btn-website');
		const btnBack = document.getElementById('btn-back');
		const btnReset = document.getElementById('btn-reset-view');
		const btnToggleFlight = document.getElementById('btn-toggle-flight');
		const flightModeLabel = document.getElementById('flight-mode-label');
		const mainContent = document.getElementById('main-content');
		const mainMask = document.getElementById('main-mask');
		const progress = document.getElementById('scroll-progress');
		const indicator = document.getElementById('scroll-indicator');
		const percentageText = document.getElementById('scroll-percentage');

		if (mainContent && mainMask && progress && indicator && percentageText) {
			const updateScroll = () => {
				const { scrollTop, scrollHeight, clientHeight } = mainContent;
				const page = scrollTop / clientHeight;
				const aboutRange = scrollHeight - clientHeight * 2;
				const percent = aboutRange > 0 ? Math.max(0, (scrollTop - clientHeight) / aboutRange) * 100 : 0;

				progress.style.opacity = page > 3 ? '1' : '0';
				indicator.style.height = `${percent}%`;
				percentageText.textContent = `${Math.round(percent)}%`;
			};

			mainContent.addEventListener('scroll', updateScroll, { passive: true });
			updateScroll();
		}

		if (btnWebsite && btnBack && btnReset && btnToggleFlight && mainContent && mainMask) {
			const setFlightMode = (enabled: boolean) => {
				btnToggleFlight.dataset.enabled = String(enabled);
				btnToggleFlight.title = enabled
					? (btnToggleFlight.dataset.titleDisable ?? '')
					: (btnToggleFlight.dataset.titleEnable ?? '');
				if (flightModeLabel) {
					flightModeLabel.textContent = enabled
						? (btnToggleFlight.dataset.labelDisable ?? '')
						: (btnToggleFlight.dataset.labelEnable ?? '');
				}
				window.dispatchEvent(new CustomEvent('solar-flight-mode-change', {
					detail: { enabled },
				}));
			};

			btnWebsite.addEventListener('click', (e) => {
				e.preventDefault();
				mainContent.style.opacity = '0';
				mainContent.style.pointerEvents = 'none';
				mainMask.style.opacity = '0';
				mainMask.style.pointerEvents = 'none';

				btnBack.style.opacity = '1';
				btnBack.style.pointerEvents = 'auto';
				btnToggleFlight.style.opacity = '1';
				btnToggleFlight.style.pointerEvents = 'auto';
				btnReset.style.opacity = '1';
				btnReset.style.pointerEvents = 'auto';
			});

			btnToggleFlight.addEventListener('click', () => {
				setFlightMode(btnToggleFlight.dataset.enabled !== 'true');
			});

			btnBack.addEventListener('click', () => {
				setFlightMode(false);
				mainContent.style.opacity = '1';
				mainContent.style.pointerEvents = 'auto';
				mainMask.style.opacity = '1';
				mainMask.style.pointerEvents = 'auto';

				btnBack.style.opacity = '0';
				btnBack.style.pointerEvents = 'none';
				btnToggleFlight.style.opacity = '0';
				btnToggleFlight.style.pointerEvents = 'none';
				btnReset.style.opacity = '0';
				btnReset.style.pointerEvents = 'none';
			});
		}

	});
</script>
