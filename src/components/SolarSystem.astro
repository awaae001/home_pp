---
// SolarSystem component - Three.js 星系背景
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="solar-system-container"
  class="fixed inset-0 z-0"
  data-flight-enabled={t("home.flight.status.enabled")}
  data-flight-disabled={t("home.flight.status.disabled")}
  data-camera-label={t("home.camera")}
  data-fps-label={t("home.fps")}
  data-loader-loading={t("home.solar.loading")}
  data-loader-restoring={t("home.solar.restoring")}
  data-loader-model={t("home.solar.model")}
  data-loader-shaders={t("home.solar.shaders")}
  data-loader-ready={t("home.solar.ready")}
  data-loader-cached-model={t("home.solar.cachedModel")}
>
  <canvas id="solar-canvas"></canvas>
  <output id="camera-position" aria-live="polite">
    <span id="flight-hud"></span>
    <span id="camera-stats"></span>
  </output>
</div>
<div id="solar-loader" role="status" aria-live="polite">
  <span class="loader-mark" aria-hidden="true"></span>
  <span id="solar-loader-text">{t("home.solar.loading")}</span>
</div>

<script>
  const SOLAR_WARMED_KEY = 'solar-system:warmed';
  let cleanup: (() => void) | undefined;
  let loadGeneration = 0;

  document.addEventListener('astro:page-load', async () => {
    cleanup?.();
    cleanup = undefined;

    const generation = ++loadGeneration;
    const canvas = document.getElementById('solar-canvas') as HTMLCanvasElement;
    const loader = document.getElementById('solar-loader');
    const loaderText = document.getElementById('solar-loader-text');
    if (!canvas) {
      return;
    }

    const warmed = sessionStorage.getItem(SOLAR_WARMED_KEY) === 'true';
    const solarContainer = document.getElementById('solar-system-container');
    const loaderLabels = {
      loading: solarContainer?.dataset.loaderLoading ?? 'Downloading Three.js environment…',
      restoring: solarContainer?.dataset.loaderRestoring ?? 'Restoring star map…',
      model: solarContainer?.dataset.loaderModel ?? 'Downloading model…',
      shaders: solarContainer?.dataset.loaderShaders ?? 'Compiling shaders…',
      ready: solarContainer?.dataset.loaderReady ?? 'Loaded…',
      cachedModel: solarContainer?.dataset.loaderCachedModel ?? 'Trying to restore model from cache…',
    };
    if (warmed) {
      loader?.classList.add('is-warmed');
    }

    console.log(`[Solar] ${warmed ? '从会话缓存恢复' : '开始下载'} Three.js 环境……`);
    loaderText && (loaderText.textContent = warmed
      ? loaderLabels.restoring
      : loaderLabels.loading);
    const { initSolarSystem } = await import('../scripts/solarSystem');
    console.log('[Solar] Three.js 下载完成，开始初始化……');
    if (generation !== loadGeneration || !canvas.isConnected) {
      return;
    }

    const stageLabels = {
      model: loaderLabels.model,
      shaders: loaderLabels.shaders,
      ready: loaderLabels.ready,
    } as const;
    const dispose = await initSolarSystem(canvas, {
      warmed,
      onLoadStage: (stage) => {
        if (generation === loadGeneration && loaderText) {
          loaderText.textContent = warmed && stage === 'model'
            ? loaderLabels.cachedModel
            : stageLabels[stage];
        }
      },
    });

    if (generation !== loadGeneration || !canvas.isConnected) {
      dispose();
      return;
    }

    cleanup = dispose;
    sessionStorage.setItem(SOLAR_WARMED_KEY, 'true');
    console.log('[Solar] 初始化完成，画布就绪');
    canvas.classList.add('is-ready');
    if (loader) {
      if (!warmed) {
        await new Promise((r) => window.setTimeout(r, 1000));
      }
      if (generation === loadGeneration) {
        console.log('[Solar] 加载完成，循环已就绪');
        loader!.classList.add('is-complete');
      }
    }
  });

  document.addEventListener('astro:before-swap', () => {
    loadGeneration += 1;
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  #solar-system-container {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  :global(.project-transition-space) {
    animation: depart-upward var(--motion-duration-slow) var(--motion-ease) forwards;
    will-change: transform, opacity;
  }

  :global(.project-transition-content) {
    animation: fade-for-departure var(--motion-duration) var(--motion-ease-exit) forwards;
    pointer-events: none;
  }

  @keyframes depart-upward {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-32vh) scale(1.08);
    }
  }

  @keyframes fade-for-departure {
    to {
      opacity: 0;
      transform: translateY(-24px);
    }
  }


  #solar-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms var(--motion-ease);
  }

  #solar-canvas.is-ready {
    opacity: 1;
  }

  #solar-loader {
    position: fixed;
    z-index: 30;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgb(255 255 255 / 62%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    transition: opacity 600ms var(--motion-ease);
    pointer-events: none;
  }

  #solar-loader.is-complete {
    opacity: 0;
    transition-delay: 500ms;
  }

  #solar-loader.is-warmed {
    transition-duration: 180ms;
  }

  #solar-loader.is-warmed.is-complete {
    transition-delay: 0ms;
  }

  .loader-mark {
    width: 0.38rem;
    height: 0.38rem;
    background: currentColor;
    border-radius: 50%;
    animation: loader-pulse 1200ms ease-in-out infinite;
  }

  @keyframes loader-pulse {
    50% {
      opacity: 0.25;
      transform: scale(0.7);
    }
  }

  #camera-position {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: rgba(255, 255, 255, 0.65);
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  #flight-hud {
    color: rgba(255, 255, 255, 0.82);
  }

  :global(.solar-tooltip) {
    position: fixed;
    z-index: 1000;
    padding: 0.5rem 0.75rem;
    color: white;
    font-size: 0.875rem;
    pointer-events: none;
    background: rgb(0 0 0 / 80%);
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 0.375rem;
    backdrop-filter: blur(4px);
  }

</style>
