---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
/** 男人走路这段占几屏 */
const WALK_SCREENS = 2.8;
/** 走完以后飞船从窗外飞过占几屏 */
const FLY_SCREENS = 1;
/** 玻璃上的字：at 是窗户还没挪时字左边在玻璃上的位置（NDC），1 就是刚好在画面右边外 */
const glassTexts = [
	{ at: '1', title: t('about.walk.far'), caption: t('about.walk.lunch') },
	// 跟拍结束、对面的人走来时才滑进画面
	{ at: 'calc(1 + var(--deck-follow))', title: t('about.meet.far'), caption: t('about.meet.words') },
];
---

<!-- 关于我：桌面端太阳在左、文字在右，手机端太阳在上、文字在下。
     第二、三屏镜头倒退进舱，文字跟着太阳缩小（--zoom）；
     之后 WALK_SCREENS 屏男人走进来，窗户往左挪，对面走来另一个他擦肩而过；
     再 FLY_SCREENS 屏飞船从窗外飞过；
     卡片和玻璃上的字跟着窗户移出（--deck-shift） -->
<div id="about-track" class="relative w-full" style={`height: ${(3 + WALK_SCREENS + FLY_SCREENS) * 100}dvh`} data-walk-screens={WALK_SCREENS} data-fly-screens={FLY_SCREENS}>
	<div id="about" class="absolute top-0 h-dvh w-full snap-center"></div>
	<!-- 比一屏高的吸附区域内可以自由停留 -->
	<div class="absolute top-0 h-full w-full snap-start" aria-hidden="true"></div>
	<div class="sticky top-0 h-dvh w-full overflow-hidden">
		<div id="about-stage" class="about-stage h-full w-full flex flex-col items-center justify-end pb-[16dvh] md:justify-center md:pb-0 md:pl-[50%]">
			<div class="relative flex items-center gap-5 text-white">
				<!-- 进舱以后卡片变成 HUD，下面这条是投影源 -->
				<div class="hud-base" aria-hidden="true"></div>
				<img src="/avatar.webp" alt="awaae001" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover border-2 border-white/20" />
				<div class="flex flex-col gap-1">
					<span class="invert-text text-2xl md:text-3xl font-bold font-hand">awaae001</span>
					<span class="invert-text tracking-wide" style="--ink: 0.8">{t('about.role')}</span>
				</div>
			</div>
		</div>
		{glassTexts.map(({ at, title, caption }) => (
			<div class="glass-text absolute top-[22%] flex flex-col gap-3 md:gap-5 whitespace-nowrap" style={`--at: ${at}`}>
				<p class="invert-text text-lg md:text-4xl font-light tracking-[0.15em] md:tracking-[0.3em]" style="--ink: 0.85">{title}</p>
				<p class="invert-text text-xs md:text-sm tracking-[0.2em]" style="--ink: 0.45">{caption}</p>
			</div>
		))}
	</div>
</div>

<style>
	.about-stage {
		/* 窗户开始挪以后，卡片像贴在玻璃上一样跟着窗户走 */
		transform: translateX(calc(var(--deck-shift, 0) * -50vw)) scale(var(--zoom, 1));
		transform-origin: 50% 50%;
	}

	/* 投影源：一条冷白光条托住卡片，往上打一片淡淡的光；进舱时淡入 */
	.hud-base {
		--hud-light: 220 232 255;
		position: absolute;
		top: calc(100% + 1.25rem);
		left: -0.5rem;
		right: -2.5rem;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgb(var(--hud-light) / 85%) 10%, rgb(var(--hud-light) / 85%) 90%, transparent);
		box-shadow: 0 0 12px rgb(var(--hud-light) / 55%);
		opacity: var(--glass, 0);
		pointer-events: none;
	}

	.hud-base::before {
		content: '';
		position: absolute;
		inset: auto 0 100% 0;
		height: 8rem;
		background: linear-gradient(to top, rgb(var(--hud-light) / 14%), transparent);
		mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
	}

	/* 和背景取反色：太阳椭圆（--sun，脚本每帧给出）里是黑字，外面是白字，--ink 是不透明度 */
	.invert-text {
		color: transparent;
		background-image: radial-gradient(
			ellipse var(--sun, 0px 0px at -1px -1px),
			rgb(0 0 0 / var(--ink, 1)) 100%,
			rgb(255 255 255 / var(--ink, 1)) 100%
		);
		background-clip: text;
		-webkit-background-clip: text;
	}

	/* 写在玻璃上：和窗户同速，不模糊，男人从字前面走过 */
	.glass-text {
		left: calc(50% + var(--at) * 50%);
		transform: translateX(calc(var(--deck-shift, 0) * -50vw));
	}
</style>
