---
import { execFileSync } from "node:child_process";
import { Icon } from "astro-icon/components";
import { defaultLang, delocalizePath, languages, localizePath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const basePath = delocalizePath(Astro.url.pathname);
const isHomePage = basePath === "/";

const startYear = 2023;
const currentYear = new Date().getFullYear();
const copyrightYear =
  currentYear > startYear ? `${startYear} - ${currentYear}` : startYear;
const commitSha =
  process.env.CF_PAGES_COMMIT_SHA ??
  process.env.VERCEL_GIT_COMMIT_SHA ??
  process.env.GITHUB_SHA;
const gitId = commitSha?.slice(0, 7) ?? getLocalGitId();

function getLocalGitId(): string {
  try {
    return execFileSync("git", ["rev-parse", "--short=7", "HEAD"], {
      encoding: "utf8",
    }).trim();
  } catch {
    return "unknown";
  }
}
---

<div
  class:list={["fixed bottom-4 right-4 text-xs leading-relaxed text-gray-400 text-right z-20 flex-col", isHomePage ? "hidden md:flex" : "flex"]}
>
  <div aria-label={t("lang.switch")} class="mb-1 flex items-center justify-end gap-2">
    <Icon name="mdi:translate" class="w-4 h-4 text-gray-500" />
    {Object.entries(languages).map(([language, label], index) => (
      <>
        {index > 0 && <span class="text-gray-600">·&nbsp;</span>}
        <a
          href={localizePath(basePath, language as Lang)}
          data-lang-link={language}
          aria-current={language === lang ? "true" : undefined}
          class={language === lang ? "text-white" : "hover:text-white transition-colors"}
        >{label}</a>
      </>
    ))}
  </div>
  <div>
    <span>{gitId}</span> ·&nbsp;
    <a
      href="https://github.com/awaae001/home_pp"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-white transition-colors">GitHub</a
    > ·&nbsp;
    <a
      href="https://astro.build/"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-white transition-colors"
    >
      Astro</a
    >
  </div>
  <div>&copy; {copyrightYear} All rights reserved.</div>
</div>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("a[data-lang-link]");
    if (!link) return;
    try {
      localStorage.setItem("preferred-lang", link.dataset.langLink ?? "");
    } catch {}
  });
</script>
