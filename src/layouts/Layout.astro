---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { defaultLang, delocalizePath, localizePath, languages, type Lang } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	lang?: Lang;
}

const {
	title = 'awaae001 · Home',
	description = 'The personal homepage of awaae001 — about myself, for the world, for visitors, and for those damned futures.',
	canonicalPath = '/',
	lang = defaultLang,
} = Astro.props;

const siteUrl = 'https://awaae001.top';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const basePath = delocalizePath(canonicalPath);
const ogImage = `${siteUrl}/favicon.svg`;
const htmlLang = lang === 'zh' ? 'zh-CN' : lang;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
---

<!doctype html>
<html lang={htmlLang} transition:animate={fade({ duration: 'var(--motion-duration)' })}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		{Object.keys(languages).map((l) => (
			<link
				rel="alternate"
				hreflang={l === 'zh' ? 'zh-CN' : l}
				href={new URL(localizePath(basePath, l as Lang), siteUrl).toString()}
			/>
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(basePath, siteUrl).toString()} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="awaae001" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0d1117" />
		<meta name="color-scheme" content="dark" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="awaae001" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>
		<script is:inline>
			(function () {
				try {
					var stored = null;
					try { stored = localStorage.getItem('preferred-lang'); } catch (e) {}
					var browser = String(navigator.language || 'zh').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en';
					var preferred = stored || browser;
					var current = location.pathname.split('/')[1] === 'zh' ? 'zh' : 'en';
					if (preferred !== current) {
						var rest = current === 'zh' ? (location.pathname.slice(3) || '/') : location.pathname;
						var target = preferred === 'zh' ? (rest === '/' ? '/zh' : '/zh' + rest) : rest;
						location.replace(target + location.search + location.hash);
					}
				} catch (e) {}
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<Footer lang={lang} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #0d1117;
	}
</style>
