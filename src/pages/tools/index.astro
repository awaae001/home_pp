---
import { Icon } from "astro-icon/components";
import ToolsLayout from "../../layouts/ToolsLayout.astro";

const tools = [
	{
		href: "/tools/string-mask",
		name: "字符串打码",
		desc: "保留开头字符，自选符号打码，一键复制。",
		icon: "mdi:asterisk",
	},
	{
		href: "/tools/icon-converter",
		name: "Icon 转换器",
		desc: "上传 JPG / PNG，一键生成 favicon.ico。",
		icon: "mdi:image-sync",
	},
	{
		href: "/tools/exe-icon-extractor",
		name: "EXE 图标提取器",
		desc: "上传 EXE / DLL，导出内置 ICO 图标。",
		icon: "mdi:application-export",
	},
];
---

<ToolsLayout title="工具箱 · awaae001" heading="工具箱" backHref="/" backTitle="返回主页" wide>
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			tools.map((tool) => (
				<a
					href={tool.href}
					class="group rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/10"
				>
					<Icon
						name={tool.icon}
						class="h-7 w-7 text-gray-400 transition group-hover:text-white"
					/>
					<strong class="mt-3 block text-white">{tool.name}</strong>
					<span class="mt-1 block text-sm leading-relaxed text-gray-400">
						{tool.desc}
					</span>
				</a>
			))
		}
	</div>
</ToolsLayout>
